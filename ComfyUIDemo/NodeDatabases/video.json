{
  "category": "视频处理",
  "categoryIcon": "film",
  "nodes": [
    {
      "type": "SaveVideo",
      "displayName": "保存视频",
      "colorHex": "#19D3F3",
      "description": "将VIDEO保存为视频文件到输出目录",
      "inputs": [
        {"name": "video", "type": "VIDEO"}
      ],
      "outputs": [
        {"name": "video", "type": "VIDEO"}
      ],
      "parameters": [
        {"name": "filename_prefix", "displayName": "文件名前缀", "type": "string", "defaultValue": "video/MiniMax_H3"},
        {"name": "fps", "displayName": "帧率", "type": "enumeration", "defaultValue": "auto", "options": ["auto", "8", "12", "16", "24", "30", "60"]},
        {"name": "codec", "displayName": "编码格式", "type": "enumeration", "defaultValue": "auto", "options": ["auto", "h264", "h265", "vp9", "av1", "gif", "webp"]}
      ]
    },
    {
      "type": "CreateVideo",
      "displayName": "创建视频",
      "colorHex": "#19D3F3",
      "description": "将图像序列与音频合成为VIDEO",
      "inputs": [
        {"name": "images", "type": "IMAGE"},
        {"name": "audio", "type": "AUDIO"}
      ],
      "outputs": [
        {"name": "VIDEO", "type": "VIDEO"}
      ],
      "parameters": [
        {"name": "fps", "displayName": "帧率", "type": "integer", "defaultValue": "24", "minValue": 1, "maxValue": 120, "step": 1},
        {"name": "select_every_nth", "displayName": "抽帧间隔", "type": "integer", "defaultValue": "8", "minValue": 1, "maxValue": 64, "step": 1}
      ]
    }
  ]
}
